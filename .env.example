# 로컬 개발용 환경 변수. 이 파일을 .env로 복사한 뒤 값을 채운다. (cp .env.example .env)
# .env는 커밋하지 않는다.
# lolog-api의 compose.yaml이 띄운 PostgreSQL 비밀번호. lolog-api .env의 POSTGRES_PASSWORD와 같은 값이다.
POSTGRES_PASSWORD=change-me
# 액세스 토큰(JWT) 서명 비밀값. 32바이트 이상. lolog-api .env의 JWT_SECRET과 같은 값을 넣는다.
JWT_SECRET=change-me-to-at-least-32-bytes-long-value
