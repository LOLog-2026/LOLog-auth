# 로컬 개발용 환경 변수. 이 파일을 .env로 복사한 뒤 값을 채운다. (cp .env.example .env)
# .env는 커밋하지 않는다.
# lolog-api의 compose.yaml이 띄운 PostgreSQL 비밀번호. lolog-api .env의 POSTGRES_PASSWORD와 같은 값이다.
POSTGRES_PASSWORD=change-me
# 액세스 토큰(JWT) 서명 비밀값. 32바이트 이상. lolog-api .env의 JWT_SECRET과 같은 값을 넣는다.
JWT_SECRET=change-me-to-at-least-32-bytes-long-value
# lolog-api /internal 주소의 X-Internal-Token 값. lolog-api .env의 INTERNAL_TOKEN과 같은 값을 넣는다.
INTERNAL_TOKEN=change-me
# 가입 인증번호 메일. 비워 두면 메일을 보내지 않고 인증번호를 콘솔에 찍는다.
# 실제로 보내 보려면 MAIL_LOG_ONLY=false로 바꾸고 Gmail 계정과 앱 비밀번호를 넣는다.
MAIL_LOG_ONLY=true
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
